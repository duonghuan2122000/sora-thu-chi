<?xml version="1.0" encoding="utf-8"?>
<!-- Splash tầng native (trước frame Flutter đầu tiên) — nền teal thương hiệu +
     logo căn giữa. Cỡ 140dp khớp `PinGate.logoWidth` để không nhảy hình giữa
     hai tầng (FR-010). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_teal" />
    <item
        android:drawable="@drawable/splash_logo"
        android:width="140dp"
        android:height="140dp"
        android:gravity="center" />
</layer-list>
